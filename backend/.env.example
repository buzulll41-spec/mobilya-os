# ── Zorunlu / production-kritik ──
# Ortam: production'da MUTLAKA "production" olmalı (CORS kilidi, log seviyesi, Prisma).
NODE_ENV=development

# PostgreSQL bağlantısı (production'da gerçek DB URL'i ile değiştirin).
DATABASE_URL="postgresql://mobilya:mobilya@localhost:5432/mobilya?schema=public"
PORT=4000

# "Operasyonel bugün". Demo/preview için sabit tarih. DİKKAT: birçok servis set
# edilmezse '2026-05-14'e düşer → production'da tarih mantığı DONAR. Gerçek zaman için
# production'da uygun bir değere set edin (veya operasyon takvimine göre yönetin).
DEMO_TODAY=2026-05-14

# Virgülle ayrılmış izinli origin listesi. Tercih edilen değişken: CORS_ALLOWED_ORIGINS.
# Geriye uyumluluk için CORS_ORIGIN de okunur.
CORS_ALLOWED_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174

# ZORUNLU: yoksa uygulama açılışta hata verir. Production'da GÜÇLÜ, rastgele bir değer.
# Tercih edilen değişken: JWT_SECRET. Geriye uyumluluk için AUTH_JWT_SECRET de okunur.
JWT_SECRET=change-me-in-production

# GÜVENLİK: Bunu production'da ASLA set etmeyin. 'true' iken tüm kimlik doğrulama ve
# RBAC devre dışı kalır ve her istek ADMIN olur (yalnızca test/local için kullanılır).
# AUTH_DISABLED=false

# FAZ 40/43 — Real AI Integration (server-side only)
AI_WORKER_ENABLED=false
AI_LLM_PROVIDER=mock
AI_WORKER_MODEL=gpt-4o-mini
AI_LLM_TEMPERATURE=0.2
AI_LLM_MAX_TOKENS=1200
AI_LLM_TIMEOUT_MS=30000
AI_LLM_MAX_RETRIES=2
AI_LLM_STREAM_ENABLED=true
AI_LLM_COST_TRACKING=true
# AI araç yürütme (opsiyonel; default kapalı). Yalnızca gerektiğinde açın.
# AI_TOOL_EXECUTION_ENABLED=false
OPENAI_API_KEY=
GEMINI_API_KEY=
# AI_PROMPT_VERSION=v1
# AI_PROMPT_DW_SALES_FOLLOW_UP=v1
WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
