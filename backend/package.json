{
  "name": "mobilya-os-backend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MOBILYA OS Enterprise 1.0 backend API",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset-demo": "tsx prisma/resetDemo.ts",
    "seed": "npm run db:seed",
    "db:studio": "prisma studio",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.1",
    "@prisma/client": "^6.19.0",
    "dotenv": "^17.4.2",
    "fastify": "^5.2.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "prisma": "^6.19.0",
    "tsx": "^4.19.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.4"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
