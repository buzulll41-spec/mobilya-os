{
  "name": "mobilya-os",
  "private": true,
  "version": "1.0.0",
  "description": "MOBILYA OS Enterprise 1.0",
  "scripts": {
    "test:client": "npm --prefix client test",
    "test:backend": "npm --prefix backend test",
    "test": "npm run test:backend && npm run test:client",
    "lint:client": "npm --prefix client run lint",
    "build:backend": "npm --prefix backend run build",
    "build:client": "npm --prefix client run build",
    "build": "npm run build:backend && npm run build:client",
    "release:validate": "npm run test && npm run lint:client && npm run build",
    "prod:up": "docker compose --env-file env/.production -f docker-compose.production.yml up -d --build",
    "prod:down": "docker compose --env-file env/.production -f docker-compose.production.yml down",
    "prod:logs": "docker compose --env-file env/.production -f docker-compose.production.yml logs -f",
    "prod:smoke": "node scripts/production-smoke.mjs",
    "prod:report": "node scripts/production-ready-report.mjs",
    "prod:ready": "npm run prod:up && npm run prod:smoke && npm run prod:report",
    "prod:rc": "node scripts/release-candidate.mjs"
  }
}
