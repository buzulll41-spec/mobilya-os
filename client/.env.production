# Production build ayarları (vite build → mode=production bu dosyayı yükler).
# Amaç: production'da yanlışlıkla mock/demo/localhost'a düşmeyi imkânsız kılmak.

# Uygulama production modunda çalışır → mock veri kullanımı assertProductionDataSource()
# ile engellenir (boş/mock API'de sessizce mock'a düşmek yerine HATA verir).
VITE_APP_MODE=production

# Runtime mod değiştirme kapalı → production build demo/mock'a çevrilemez.
VITE_ALLOW_RUNTIME_MODE=false

# Gerçek production API adresi DEPLOY sırasında enjekte edilir (env değişkeni ile),
# örn: VITE_API_BASE_URL=https://<render-service>.onrender.com
# Placeholder değer commitlidir; canlı deploy'da gerçek Render URL ile değiştirin.
# Localhost yalnızca .env (dev) içindir.
VITE_API_BASE_URL=https://your-render-service.onrender.com
