# ── Local geliştirme (bu dosyayı .env olarak kopyalayın) ──
# Backend'i "npm run dev" ile çalıştırın (PostgreSQL: docker compose up -d).
VITE_API_BASE_URL=http://localhost:4000

# demo | development | production. Local için boş/demo bırakın.
# Production ayarları client/.env.production içindedir; gerçek production API adresi
# deploy sırasında env değişkeni ile enjekte edilir (localhost/mock KULLANILMAZ).
# VITE_APP_MODE=demo

# FAZ 47 — Autonomous AI Company (Company Brain)
VITE_COMPANY_BRAIN_ENABLED=true

# FAZ 100 — Genesis Engine (living digital company)
VITE_GENESIS_ENABLED=true

# FAZ 101 — Go Live (runtime mode switch for ADMIN testing only)
VITE_ALLOW_RUNTIME_MODE=false
# VITE_LLM_PROVIDER=openai

# FAZ 102 — CEO Copilot V1
VITE_CEO_COPILOT_ENABLED=true

# ── Opsiyonel bayraklar (kod içinde default'ları var; set edilmezse default kullanılır) ──
# Aşağıdakiler yorumlu bırakıldı; yalnızca default'u değiştirmek isterseniz açın.
# VITE_CEO_COPILOT_MAX_HISTORY=20
# VITE_COMPANY_BRAIN_SCAN_MS=60000
# VITE_COMPANY_MANAGER_ENABLED=false
# VITE_COMPANY_MANAGER_SCAN_MS=30000
# VITE_GENESIS_HEARTBEAT_MS=1000
# VITE_GENESIS_BRAIN_SCAN_MS=30000
# VITE_GENESIS_BOARD_HOUR=9
# VITE_AI_WORKERS_ENABLED=false
# VITE_DIGITAL_EMPLOYEE_ENABLED=false
# LLM sağlayıcı (yalnızca frontend gösterim/etiket için; gerçek çağrı backend'de):
# VITE_LLM_PROVIDER=openai
# VITE_OPENAI_MODEL=gpt-4o-mini
# VITE_GEMINI_MODEL=gemini-1.5-flash
