{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/mobile",
      "destination": "/index.html"
    },
    {
      "source": "/mobile/(.*)",
      "destination": "/index.html"
    }
  ]
}
