# Runtime profile
NODE_ENV=production

# Networking
NGINX_PORT=80
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database
POSTGRES_USER=mobilya
POSTGRES_PASSWORD=prod_local_secure_pw_2026
POSTGRES_DB=mobilya_prod
DATABASE_URL=postgresql://mobilya:prod_local_secure_pw_2026@localhost:5432/mobilya_prod?schema=public

# Security
JWT_SECRET=prod_local_jwt_secret_2026_very_strong
AUTH_DISABLED=false
CORS_ALLOWED_ORIGINS=https://app.mobilya-os.com

# App boot
RUN_SEED_ON_BOOT=false
LOG_LEVEL=info
LOG_FORMAT=json

# Ops
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_INTERVAL_SECONDS=86400
MONITOR_INTERVAL_SECONDS=30
