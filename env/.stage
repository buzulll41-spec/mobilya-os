# Runtime profile
NODE_ENV=production

# Networking
NGINX_PORT=28080
POSTGRES_PORT=25432
REDIS_PORT=26379

# Database
POSTGRES_USER=mobilya
POSTGRES_PASSWORD=stage_change_me
POSTGRES_DB=mobilya_stage
DATABASE_URL=postgresql://mobilya:stage_change_me@localhost:25432/mobilya_stage?schema=public

# Security
JWT_SECRET=stage_jwt_secret_change_me_123456
AUTH_DISABLED=false
CORS_ALLOWED_ORIGINS=https://stage.mobilya-os.local

# App boot
RUN_SEED_ON_BOOT=true
LOG_LEVEL=info
LOG_FORMAT=json

# Ops
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_INTERVAL_SECONDS=86400
MONITOR_INTERVAL_SECONDS=30
