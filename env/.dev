# Runtime profile
NODE_ENV=development

# Networking
NGINX_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# Database
POSTGRES_USER=mobilya
POSTGRES_PASSWORD=mobilya_dev_change_me
POSTGRES_DB=mobilya_dev
DATABASE_URL=postgresql://mobilya:mobilya_dev_change_me@localhost:5432/mobilya_dev?schema=public

# Security
JWT_SECRET=dev_jwt_secret_change_me_123456
AUTH_DISABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# App boot
RUN_SEED_ON_BOOT=true
LOG_LEVEL=debug
LOG_FORMAT=json

# Ops
BACKUP_CRON_SCHEDULE=0 2 * * *
BACKUP_INTERVAL_SECONDS=86400
MONITOR_INTERVAL_SECONDS=30
